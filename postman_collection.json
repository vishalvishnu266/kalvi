									"",
									"pm.test(\"Response has required fields\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData).to.have.property('total_students');",
									"    pm.expect(jsonData).to.have.property('recent_students');",
									"});"
